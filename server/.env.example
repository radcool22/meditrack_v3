PORT=5001
NODE_ENV=development

# Twilio (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI (LLM analysis)
OPENAI_API_KEY=

# ElevenLabs (TTS voice + WhatsApp voice-note transcription)
ELEVENLABS_API_KEY=

# Google Vision / Document AI (OCR)
GOOGLE_CLOUD_API_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reports

# Public base URL of this app (render callbacks are sent here; CORS origin)
APP_BASE_URL=

# Render service (video generation)
RENDER_SERVICE_URL=https://meditrack-render-v3.fly.dev
RENDER_API_KEY=
CALLBACK_SHARED_SECRET=
R2_PUBLIC_URL=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret — verifies X-Hub-Signature-256 on incoming webhooks.
# Unset = signatures not checked (a warning is logged once).
WHATSAPP_APP_SECRET=
